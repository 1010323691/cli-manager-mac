#!/bin/bash
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd -P)"
if [[ ! -f "$here/../app-path" ]]; then
    printf '%s\n' "Install the app and skill together using scripts/install." >&2
    exit 2
fi
IFS= read -r app < "$here/../app-path"
resources="$app/Contents/Resources"
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

case "${1:-}" in
    docs) printf '%s\n' "$resources/Legacy/references"; exit 0 ;;
    desktop) shift ;;
    planner) ;;
    *) set -- legacy "$@" ;;
esac
entry="$resources/desktop.py"
if [[ ! -f "$entry" ]]; then
    printf '%s\n' "Cannot find the installed CLI Manager app. Check the skill's app-path." >&2
    exit 2
fi
if [[ -n "${CLI_MANAGER_PYTHON:-}" ]]; then
    candidates=("$CLI_MANAGER_PYTHON")
else
    candidates=(python3 python3.14 python3.13 python3.12 python3.11)
fi
for candidate in "${candidates[@]}"; do
    if "$candidate" -I -c 'import sys; sys.exit(sys.version_info < (3, 11))' >/dev/null 2>&1; then
        exec "$candidate" -I -B "$entry" "$@"
    fi
done
printf '%s\n' "Python 3.11 or newer is required." >&2
exit 2
